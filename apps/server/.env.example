# Postgres connection string (e.g. a Neon database). Leave unset to use the embedded Postgres
# (PGlite) stored in DATA_DIR, which is all you need to play locally.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Where the embedded database lives when DATABASE_URL is unset.
# DATA_DIR=.data/pglite

# Base URL of the game client, used in sign-in links. Defaults to the requesting page's origin.
# CLIENT_URL=http://localhost:5173

# In production, sign-in links are not returned to the browser (they must be emailed).
# NODE_ENV=production
