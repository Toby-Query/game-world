{
  "name": "@the-world/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:@colyseus/* --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.28",
    "@colyseus/schema": "^5.0.48",
    "@colyseus/ws-transport": "^0.18.5"
  },
  "devDependencies": {
    "@the-world/shared": "workspace:*",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
